# TrustMart Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=localhost
DB_NAME=trustmart
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Payment Configuration
PAYMENT_BASE_URL=http://localhost/Trustmart
PAYMENT_CALLBACK_SECRET=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION

# ToyyibPay Settings (optional)
TOYYIBPAY_ENABLED=false
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_API_URL=https://dev.toyyibpay.com

# Application Settings
APP_ENV=development
APP_DEBUG=true

# ── Demo / email delivery of account links ──────────────────────
# Activation and password-reset links are ALWAYS emailed to the account
# address. The link is additionally returned in the API response ONLY for
# local demo convenience, which requires BOTH of the following:
#   1. TRUSTMART_DEV_MODE=true   (explicit opt-in; defaults to false)
#   2. The request comes from the local machine (loopback)
# NEVER enable TRUSTMART_DEV_MODE on a public/production deployment.
# On a host with no mail server (e.g. bare XAMPP), set this to true so you
# can still click the activation/reset link in the browser.
TRUSTMART_DEV_MODE=false

# Absolute base URL used to build clickable links inside emails.
# Leave blank to fall back to PAYMENT_BASE_URL.
TRUSTMART_BASE_URL=http://localhost/Trustmart

# Sender address for system emails (activation / password reset).
MAIL_FROM=no-reply@trustmart.local

# ── AI Trust Layer (TM-AI-1.0) ────────────────────────────────
# All optional — sane defaults work out of the box (pure PHP+MySQL).
AI_TRUST_ENABLED=true
# Purchases from sellers with fraud_risk >= this % are held for admin review.
# Set above 100 to disable order gating entirely.
AI_TRUST_HOLD_RISK=50
# Penalty weights (max points each detector can subtract):
AI_W_CIRCULAR=30
AI_W_REVIEW=20
AI_W_SCAM_CHAT=15
AI_W_DUPLICATE=10
# Guard for HTTP-triggered worker runs: ai_trust_worker.php?key=...
# Also used by payment/expire_unpaid.php. Both checks FAIL CLOSED: if the value
# is blank, the HTTP trigger is refused (403) — only CLI/cron runs need no key.
# Use a DIFFERENT value for each script. Generate one with:
#   php -r "echo bin2hex(random_bytes(24));"
TRUSTMART_CRON_KEY=
AI_TRUST_CRON_KEY=

# ── Optional LLM review analysis (OFF = free, offline heuristics) ─
AI_TRUST_LLM_ENABLED=false
AI_TRUST_LLM_API_KEY=
AI_TRUST_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_TRUST_LLM_MODEL=gpt-4o-mini
AI_TRUST_LLM_MAX_CALLS=200

# ── Hosting cron (cPanel example, every 30 minutes) ────────────
# */30 * * * * php -q /home/USER/public_html/ai_trust_worker.php
# */15 * * * * php -q /home/USER/public_html/payment/expire_unpaid.php
# If PHP CLI is unavailable, use an external URL pinger:
# https://YOUR-DOMAIN/ai_trust_worker.php?key=YOUR_AI_TRUST_CRON_KEY
