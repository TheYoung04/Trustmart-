# ============================================================================
# TrustMart .env.production — hardened production template
#
# Usage:  copy this file to  .env  in the deployed app root, then fill in the
#         blank secrets.  NEVER commit the resulting .env (already ignored by
#         .gitignore).  Permissions: chmod 600 .env
#
# NOTE ON FLAG NAMES: this codebase has no DB_PRODUCTION / DB_DEV_MODE
# variables (verified by grep). The equivalent production switches are:
#   APP_ENV=production + APP_DEBUG=false   -> general production posture
#   TRUSTMART_DEV_MODE=false               -> the dev-mode gate (see below)
# Keep the names below exactly as written; unknown keys are silently ignored
# by config/env.php, so a typo gives zero protection.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Use a dedicated DB user with least privilege (SELECT/INSERT/UPDATE/DELETE
# only — no DROP/GRANT). Do not use root.
DB_HOST=localhost
DB_NAME=trustmart
DB_USER=CHANGE_ME_trustmart_app
DB_PASS=
DB_CHARSET=utf8mb4

# ── Application settings ────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ── THE critical security flag (your "DB_DEV_MODE=false") ───────────────────
# When false, ALL of these are disabled:
#   * activation_link / reset_link being returned in JSON responses
#     (auth/register.php, auth/forgot_password.php via
#      trustmart_allow_demo_links()) — tokens go by email ONLY
#   * payment/gateway_sim.php test simulator (config/payment.php ::
#     payment_simulation_allowed()) — a production deploy can never
#     self-authorise a real payment through the simulator
# Defaults to false in config/env.php even if this line is deleted.
# Defence in depth: demo links also require a loopback request.
TRUSTMART_DEV_MODE=false

# ── Public origin for links inside emails ───────────────────────────────────
# mail_helper.php :: trustmart_absolute_link() uses ONLY the scheme + host +
# port from this value and never trusts the HTTP Host header.
TRUSTMART_BASE_URL=https://CHANGE_ME.example.com
PAYMENT_BASE_URL=https://CHANGE_ME.example.com

# ── Mail ────────────────────────────────────────────────────────────────────
# Sender for activation / password-reset mail. Must be a real mailbox on the
# sending domain, otherwise SPF/DKIM will fail and mail lands in spam.
MAIL_FROM=no-reply@CHANGE_ME.example.com

# ── Payment gateway: ToyyibPay (LIVE) ───────────────────────────────────────
# Enabled: with TRUSTMART_DEV_MODE=false the simulator is off, so this is the
# ONLY online payment path. pay.php also re-routes any legacy 'fpx'/'ewallet'
# request to ToyyibPay when this is true (payment/pay.php:119-127).
#
# Credentials come from YOUR toyyibPay dashboard (Settings -> Integrations):
#   TOYYIBPAY_SECRET_KEY    = "User Secret Key"
#   TOYYIBPAY_CATEGORY_CODE = the CategoryCode of a category you created for
#                             TrustMart bills (Create Category API / dashboard)
# Sandbox (https://dev.toyyibpay.com) and live credentials are NOT
# interchangeable — a sandbox key sent to the live endpoint returns
# [KEY-DID-NOT-EXIST]. Keep API_URL and credentials on the same mode.
TOYYIBPAY_ENABLED=true
TOYYIBPAY_SECRET_KEY=PASTE_USER_SECRET_KEY_HERE
TOYYIBPAY_CATEGORY_CODE=PASTE_CATEGORY_CODE_HERE
# Live bills + real bank gateway. Use https://dev.toyyibpay.com only with a
# sandbox account and sandbox credentials (bank simulator, no real money).
TOYYIBPAY_API_URL=https://toyyibpay.com

# Shared secret that signs/verifies the gateway callback. Generate one:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# (Applies to the simulator callback path only; toyyibpay payments are
#  authenticated server-side via the getBillTransactions API.)
PAYMENT_CALLBACK_SECRET=

# ── Cron HTTP guards ────────────────────────────────────────────────────────
# If the schedulers below run via PHP CLI, leave these BLANK (CLI does not need
# a key — preferred). The check FAILS CLOSED: with no key set, an HTTP request
# to expire_unpaid.php or ai_trust_worker.php is refused with 403 instead of
# running unauthenticated. If your host cannot run PHP CLI and you must ping the
# scripts over HTTP, set strong random values and use
# .../payment/expire_unpaid.php?key=<TRUSTMART_CRON_KEY> and
# .../ai_trust_worker.php?key=<AI_TRUST_CRON_KEY>.
# Use a DIFFERENT value for each: they guard scripts with different blast radii.
# Generate:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TRUSTMART_CRON_KEY=
AI_TRUST_CRON_KEY=

# ── AI trust layer (TM-AI-1.0) ──────────────────────────────────────────────
AI_TRUST_ENABLED=true
# Purchases from sellers at/above this fraud_risk % are held for admin review.
AI_TRUST_HOLD_RISK=50
AI_W_CIRCULAR=30
AI_W_REVIEW=20
AI_W_SCAM_CHAT=15
AI_W_DUPLICATE=10

# ── Optional LLM review analysis ────────────────────────────────────────────
# OFF by default: stays free and fully offline. Enabling bills per call and
# ships chat/review content to a third party — confirm your policy first, and
# keep AI_TRUST_LLM_MAX_CALLS bounded.
AI_TRUST_LLM_ENABLED=false
AI_TRUST_LLM_API_KEY=
AI_TRUST_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_TRUST_LLM_MODEL=gpt-4o-mini
AI_TRUST_LLM_MAX_CALLS=200
